# tvtimes configuration. Copy to .env — `docker compose` reads it automatically.
#
# For a normal self-hosted install you only need TVTIMES_PUBLIC_ORIGIN and
# TVTIMES_WEBAUTHN_RP_ID. Everything else has a sensible default.
# Secrets (signing key, at-rest encryption key) are generated on first run and
# kept in the `secrets` volume — you do not set them here.

# ─────────────────────────────────────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────────────────────────────────────

# The exact URL you open tvtimes at — scheme, host, and port, no trailing slash.
# Passkeys are bound to this origin, so it must match what the browser shows.
#   LAN, no TLS:     http://192.168.1.10:8888   (fine on a trusted network)
#   Behind a proxy:  https://tv.example.com
TVTIMES_PUBLIC_ORIGIN=http://localhost:8888

# WebAuthn Relying Party ID = the registrable domain of the origin above
# (no scheme, no port). Use "localhost" for a bare-IP/localhost setup, or your
# domain, e.g. tv.example.com. Passkeys stop working if you change it later.
TVTIMES_WEBAUTHN_RP_ID=localhost
TVTIMES_WEBAUTHN_RP_NAME=tvtimes

# ─────────────────────────────────────────────────────────────────────────────
# Common options
# ─────────────────────────────────────────────────────────────────────────────

# Published image to run. Pin a version for reproducible upgrades, e.g.
#   TVTIMES_IMAGE=issinoho1969/tvtimes:v1.2.0
TVTIMES_IMAGE=issinoho1969/tvtimes:latest

# Host port to expose the web app on.
TVTIMES_HTTP_PORT=8888

# Postgres password (used by both the db container and the app connection).
POSTGRES_PASSWORD=tvtimes

# ─────────────────────────────────────────────────────────────────────────────
# Email — account verification and password reset
# ─────────────────────────────────────────────────────────────────────────────
# provider: console (writes the link to the container log — fine for one user)
#           smtp | resend
TVTIMES_EMAIL_PROVIDER=console
TVTIMES_EMAIL_FROM=tvtimes <no-reply@localhost>
TVTIMES_SMTP_HOST=
TVTIMES_SMTP_PORT=587
TVTIMES_SMTP_USERNAME=
TVTIMES_SMTP_PASSWORD=
TVTIMES_RESEND_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Advanced (rarely needed)
# ─────────────────────────────────────────────────────────────────────────────
# TVTIMES_LOG_LEVEL=INFO
# Bring your own secrets instead of the generated ones (must be stable forever):
# TVTIMES_JWT_PRIVATE_KEY_PEM=
# TVTIMES_ENCRYPTION_KEY=
# Outbound fetch guard (bytes / seconds):
# TVTIMES_FETCH_TIMEOUT_SECONDS=20
# TVTIMES_FETCH_MAX_BYTES=524288000
# Hostnames/CIDRs allowed past the private-range block for M3U/Xtream/XMLTV
# URLs (HDHomeRun LAN addresses are already allowed for the hdhomerun source):
# TVTIMES_FETCH_ALLOWLIST=
