# Copy to .env for local development. Never commit .env.

# --- Core ---
TVTIMES_ENV=dev
TVTIMES_LOG_LEVEL=INFO
# Public origin the SPA is served from (WebAuthn RP origin, cookie scope).
TVTIMES_PUBLIC_ORIGIN=http://localhost:5173
# WebAuthn Relying Party. In prod: tvtimes.issinoho.com
TVTIMES_WEBAUTHN_RP_ID=localhost
TVTIMES_WEBAUTHN_RP_NAME=tvtimes

# --- Database ---
# Postgres for docker compose; falls back to sqlite+aiosqlite if unset.
TVTIMES_DATABASE_URL=postgresql+asyncpg://tvtimes:tvtimes@db:5432/tvtimes

# --- Redis (arq worker + rate limiting + caches) ---
TVTIMES_REDIS_URL=redis://redis:6379/0

# Rate-limit storage. "memory://" is per-process; use the Redis URL in prod
# so limits are shared across API instances.
TVTIMES_RATELIMIT_STORAGE_URI=memory://
TVTIMES_RATELIMIT_ENABLED=true

# --- Secrets ---
# 32-byte urlsafe-base64 key for at-rest encryption of credentials/tokens.
# Generate: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
TVTIMES_ENCRYPTION_KEY=CHANGE_ME_generate_a_real_32_byte_key
# Ed25519 private key (PEM) for signing access JWTs. Generated at startup in dev if unset.
TVTIMES_JWT_PRIVATE_KEY_PEM=

# --- Sessions ---
TVTIMES_ACCESS_TOKEN_TTL_SECONDS=900
TVTIMES_REFRESH_TOKEN_TTL_SECONDS=5184000

# --- Email (transactional: verification, password reset) ---
# provider: console (dev, prints link) | smtp | resend
TVTIMES_EMAIL_PROVIDER=console
TVTIMES_EMAIL_FROM=tvtimes <no-reply@tvtimes.issinoho.com>
TVTIMES_SMTP_HOST=
TVTIMES_SMTP_PORT=587
TVTIMES_SMTP_USERNAME=
TVTIMES_SMTP_PASSWORD=
TVTIMES_RESEND_API_KEY=

# --- Object storage (raw XMLTV blobs); optional in dev (uses local dir) ---
TVTIMES_S3_ENDPOINT=
TVTIMES_S3_BUCKET=tvtimes-epg
TVTIMES_S3_ACCESS_KEY=
TVTIMES_S3_SECRET_KEY=

# --- Outbound fetch / SSRF guard ---
TVTIMES_FETCH_TIMEOUT_SECONDS=20
TVTIMES_FETCH_MAX_BYTES=524288000
# Comma-separated hostnames/CIDRs to allow past the private-range block (dev only).
TVTIMES_FETCH_ALLOWLIST=

# --- Frontend (Vite reads VITE_* at build time) ---
# Leave unset: the SPA and API share an origin (dev uses the Vite proxy).
# Set only to target a separate API host, e.g. https://api.tvtimes.issinoho.com
# VITE_API_ORIGIN=
